// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// User & Authentication
model User {
  id            String     @id @default(cuid())
  email         String     @unique
  name          String?
  passwordHash  String
  role          UserRole   @default(CUSTOMER)
  isActive      Boolean    @default(true)
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt
  
  // Relations
  customer      Customer?
  orders        Order[]
  apiTokens     ApiToken[]
  approvals     Approval[]
  supportTickets SupportTicket[]
  
  @@index([email])
  @@index([role])
}

enum UserRole {
  ADMIN
  CUSTOMER
}

model Customer {
  id              String    @id @default(cuid())
  userId          String    @unique
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  company         String?
  phone           String?
  avatar          String?
  address         String?
  city            String?
  state           String?
  postalCode      String?
  country         String?
  stripeCustomerId String?
  totalSpent      Decimal   @default(0) @db.Decimal(12, 2)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  
  // Relations
  orders          Order[]
  subscriptions   Subscriber[]
  supportTickets  SupportTicket[]
  
  @@index([userId])
  @@index([stripeCustomerId])
}

// Products & Storefront
model Product {
  id              String    @id @default(cuid())
  slug            String    @unique
  name            String
  category        String
  shortDescription String
  fullDescription String    @db.Text
  price           Decimal  @db.Decimal(12, 2)
  salePrice       Decimal? @db.Decimal(12, 2)
  productImage    String
  gallery         String[]  @default([])
  
  // Product Details
  features        String[]  @default([])
  benefits        String[]  @default([])
  targetAudience  String    @db.Text
  faq             Json      @default("[]")
  
  // SEO
  seoTitle        String?
  seoDescription  String?
  
  // Status
  status          ProductStatus @default(DRAFT)
  version         Int       @default(1)
  
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  
  // Relations
  files           ProductFile[]
  orderItems      OrderItem[]
  aiGenerations   AIGeneration[]
  contentItems    Content[]
  
  @@index([slug])
  @@index([category])
  @@index([status])
  @@index([createdAt])
}

enum ProductStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

model ProductFile {
  id        String    @id @default(cuid())
  productId String
  product   Product   @relation(fields: [productId], references: [id], onDelete: Cascade)
  
  fileName  String
  fileUrl   String
  fileSize  Int
  fileType  String
  
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  
  @@index([productId])
}

// Orders & Payments
model Order {
  id              String    @id @default(cuid())
  orderNumber     String    @unique
  userId          String
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  customerId      String
  customer        Customer  @relation(fields: [customerId], references: [id], onDelete: Cascade)
  
  status          OrderStatus @default(PENDING)
  totalAmount     Decimal  @db.Decimal(12, 2)
  subtotal        Decimal  @db.Decimal(12, 2)
  discountAmount  Decimal  @default(0) @db.Decimal(12, 2)
  discountCode    String?
  
  stripePaymentId String?
  
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  
  // Relations
  items           OrderItem[]
  payment         Payment?
  
  @@index([userId])
  @@index([customerId])
  @@index([status])
  @@index([createdAt])
}

enum OrderStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
  CANCELLED
}

model OrderItem {
  id        String    @id @default(cuid())
  orderId   String
  order     Order     @relation(fields: [orderId], references: [id], onDelete: Cascade)
  
  productId String
  product   Product   @relation(fields: [productId], references: [id])
  
  quantity  Int       @default(1)
  price     Decimal @db.Decimal(12, 2)
  
  @@index([orderId])
  @@index([productId])
}

model Payment {
  id              String    @id @default(cuid())
  orderId         String    @unique
  order           Order     @relation(fields: [orderId], references: [id], onDelete: Cascade)
  
  stripePaymentId String    @unique
  amount          Decimal @db.Decimal(12, 2)
  currency        String    @default("usd")
  status          PaymentStatus @default(PENDING)
  
  paymentMethod   String?
  receipt         String?
  
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  
  @@index([stripePaymentId])
}

enum PaymentStatus {
  PENDING
  SUCCEEDED
  FAILED
  REFUNDED
}

// Email & Leads
model Subscriber {
  id          String    @id @default(cuid())
  email       String    @unique
  name        String?
  customerId  String?
  customer    Customer? @relation(fields: [customerId], references: [id], onDelete: SetNull)
  
  source      String    @default("website")
  leadMagnet  String?
  
  status      SubscriberStatus @default(ACTIVE)
  signupDate  DateTime  @default(now())
  
  // Email preferences
  newsletters Boolean   @default(true)
  marketing   Boolean   @default(true)
  
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  
  // Relations
  campaigns   EmailCampaignSubscriber[]
  automations EmailAutomation[]
  
  @@index([email])
  @@index([status])
  @@index([signupDate])
}

enum SubscriberStatus {
  ACTIVE
  UNSUBSCRIBED
  BOUNCED
}

model EmailCampaign {
  id          String    @id @default(cuid())
  name        String
  subject     String
  content     String    @db.Text
  
  status      CampaignStatus @default(DRAFT)
  sentAt      DateTime?
  scheduledFor DateTime?
  
  openRate   Int       @default(0)
  clickRate  Int       @default(0)
  
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  
  // Relations
  subscribers EmailCampaignSubscriber[]
  
  @@index([status])
}

model EmailCampaignSubscriber {
  id        String    @id @default(cuid())
  campaignId String
  campaign  EmailCampaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  
  subscriberId String
  subscriber Subscriber @relation(fields: [subscriberId], references: [id], onDelete: Cascade)
  
  opened    Boolean   @default(false)
  clicked   Boolean   @default(false)
  
  @@unique([campaignId, subscriberId])
  @@index([campaignId])
  @@index([subscriberId])
}

model EmailAutomation {
  id          String    @id @default(cuid())
  subscriberId String
  subscriber  Subscriber @relation(fields: [subscriberId], references: [id], onDelete: Cascade)
  
  sequence    Int       @default(1)
  emailType   EmailAutomationType
  sentAt      DateTime?
  status      AutomationStatus @default(PENDING)
  
  createdAt   DateTime  @default(now())
  
  @@index([subscriberId])
  @@index([status])
}

enum EmailAutomationType {
  WELCOME
  EDUCATIONAL
  PROBLEM
  SOLUTION
  PRODUCT_INTRO
  FAQ
  OFFER
}

enum AutomationStatus {
  PENDING
  SENT
  FAILED
  SKIPPED
}

enum CampaignStatus {
  DRAFT
  SCHEDULED
  SENT
  PAUSED
}

// Content & Marketing
model Content {
  id          String    @id @default(cuid())
  
  productId   String?
  product     Product?  @relation(fields: [productId], references: [id], onDelete: SetNull)
  
  platform    String    // instagram, facebook, twitter, tiktok, etc.
  contentType String    // post, carousel, reel, article, email, etc.
  
  title       String?
  caption     String?   @db.Text
  hook        String?
  cta         String?
  hashtags    String[]  @default([])
  
  mediaUrl    String?
  mediaPrompt String?
  
  status      ContentStatus @default(DRAFT)
  scheduledFor DateTime?
  publishedAt DateTime?
  publishedUrl String?
  
  // Analytics
  views       Int       @default(0)
  likes       Int       @default(0)
  comments    Int       @default(0)
  shares      Int       @default(0)
  clicks      Int       @default(0)
  
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  
  @@index([platform])
  @@index([status])
  @@index([productId])
  @@index([scheduledFor])
}

enum ContentStatus {
  DRAFT
  READY
  APPROVED
  SCHEDULED
  PUBLISHED
  FAILED
}

// AI Generations
model AIGeneration {
  id          String    @id @default(cuid())
  
  productId   String?
  product     Product?  @relation(fields: [productId], references: [id], onDelete: SetNull)
  
  type        AIGenerationType
  prompt      String    @db.Text
  
  result      Json      // Store the generated content
  status      AIGenerationStatus @default(IDEA)
  
  // Product Factory fields
  targetAudience  String?
  problem         String?
  productType     String?
  topic           String?
  desiredPrice    Decimal? @db.Decimal(12, 2)
  complexity      String?
  additionalInstructions String? @db.Text
  
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  
  @@index([type])
  @@index([status])
  @@index([productId])
}

enum AIGenerationType {
  PRODUCT_IDEA
  MARKET_RESEARCH
  CONTENT_MARKETING
  SOCIAL_POST
  EMAIL
  SALES_COPY
  SEO
  OPPORTUNITY
}

enum AIGenerationStatus {
  IDEA
  DRAFT
  QA
  APPROVED
  PUBLISHED
  ARCHIVED
}

// Opportunities
model Opportunity {
  id              String    @id @default(cuid())
  
  niche           String
  audience        String
  problem         String    @db.Text
  productIdea     String    @db.Text
  
  demandScore     Int       @default(0)  // 0-100
  competitionScore Int      @default(0) // 0-100
  urgencyScore    Int       @default(0) // 0-100
  aiCreationScore Int       @default(0) // 0-100
  revenuePotential Decimal  @default(0) @db.Decimal(12, 2)
  recurringPotential Boolean @default(false)
  riskScore       Int       @default(0) // 0-100
  
  opportunityScore Int      @default(0) // 0-100
  evidence        String    @db.Text
  
  status          OpportunityStatus @default(NEW)
  
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  
  @@index([opportunityScore])
  @@index([status])
}

enum OpportunityStatus {
  NEW
  RESEARCHING
  CONVERTED
  REJECTED
  ARCHIVED
}

// Customer Support
model SupportTicket {
  id          String    @id @default(cuid())
  ticketNumber String   @unique
  
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  customerId  String?
  customer    Customer? @relation(fields: [customerId], references: [id], onDelete: SetNull)
  
  category    SupportCategory
  subject     String
  description String    @db.Text
  
  status      SupportStatus @default(OPEN)
  priority    String    @default("normal")
  
  aiDraftResponse String? @db.Text
  resolution  String?   @db.Text
  resolvedAt  DateTime?
  
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  
  @@index([userId])
  @@index([status])
  @@index([createdAt])
}

enum SupportCategory {
  PRE_SALE
  ORDER_PROBLEM
  DOWNLOAD_PROBLEM
  REFUND
  TECHNICAL
  GENERAL
  PARTNERSHIP
}

enum SupportStatus {
  OPEN
  IN_PROGRESS
  WAITING_CUSTOMER
  RESOLVED
  CLOSED
}

// Analytics
model WebsiteAnalytics {
  id              String    @id @default(cuid())
  
  date            DateTime
  
  visitors        Int       @default(0)
  uniqueVisitors  Int       @default(0)
  pageViews       Int       @default(0)
  
  trafficSource   String    // organic, direct, referral, paid, etc.
  
  productViews    Int       @default(0)
  addToCart       Int       @default(0)
  checkoutStarts  Int       @default(0)
  purchases       Int       @default(0)
  
  revenue         Decimal   @default(0) @db.Decimal(12, 2)
  subscribers     Int       @default(0)
  leads           Int       @default(0)
  downloads       Int       @default(0)
  refunds         Int       @default(0)
  
  createdAt       DateTime  @default(now())
  
  @@unique([date, trafficSource])
  @@index([date])
}

// Approvals
model Approval {
  id          String    @id @default(cuid())
  
  requestType ApprovalType
  entityType  String    // Product, Campaign, etc.
  entityId    String
  
  requestedBy String
  requestedByUser User @relation(fields: [requestedBy], references: [id])
  
  reason      String    @db.Text
  expectedImpact String? @db.Text
  risk        String?   @db.Text
  
  status      ApprovalStatus @default(PENDING)
  approvedBy  String?
  approvedAt  DateTime?
  rejectionReason String?
  
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  
  @@index([status])
  @@index([entityType, entityId])
}

enum ApprovalType {
  NEW_PRODUCT
  PRICE_CHANGE
  CAMPAIGN_PUBLISHING
  SOCIAL_POST
  WEBSITE_CHANGE
  PAID_ADVERTISING
  REFUND
}

enum ApprovalStatus {
  PENDING
  APPROVED
  REJECTED
}

// Automation
model AutomationJob {
  id          String    @id @default(cuid())
  
  name        String
  type        JobType
  
  schedule    String?   // cron expression
  enabled     Boolean   @default(true)
  
  config      Json      // Job-specific configuration
  
  lastRun     DateTime?
  nextRun     DateTime?
  
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  
  // Relations
  logs        JobLog[]
  
  @@index([type])
  @@index([enabled])
}

enum JobType {
  DAILY_ANALYTICS
  GENERATE_CONTENT
  SEND_EMAIL
  PUBLISH_CONTENT
  PRODUCT_RESEARCH
  CUSTOMER_FOLLOWUP
  WEEKLY_REPORT
  SYNC_INTEGRATIONS
}

model JobLog {
  id          String    @id @default(cuid())
  
  jobId       String
  job         AutomationJob @relation(fields: [jobId], references: [id], onDelete: Cascade)
  
  status      JobStatus
  message     String?
  errorLog    String?   @db.Text
  
  startedAt   DateTime  @default(now())
  completedAt DateTime?
  
  @@index([jobId])
  @@index([status])
}

enum JobStatus {
  PENDING
  RUNNING
  SUCCESS
  FAILED
  SKIPPED
}

// Integrations
model Integration {
  id          String    @id @default(cuid())
  
  type        String    // instagram, facebook, stripe, etc.
  name        String
  
  connected   Boolean   @default(false)
  accountId   String?
  
  config      Json      // Encrypted connection config
  
  lastSync    DateTime?
  enabled     Boolean   @default(true)
  
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  
  @@unique([type, accountId])
  @@index([type])
}

// Social Accounts
model SocialAccount {
  id          String    @id @default(cuid())
  
  platform    String
  accountId   String
  accountName String
  accountHandle String
  
  accessToken String?   @db.Text
  refreshToken String?  @db.Text
  expiresAt   DateTime?
  
  enabled     Boolean   @default(true)
  lastSync    DateTime?
  
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  
  @@unique([platform, accountId])
  @@index([platform])
}

// API Tokens
model ApiToken {
  id          String    @id @default(cuid())
  
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  token       String    @unique
  name        String
  
  lastUsedAt  DateTime?
  expiresAt   DateTime?
  
  createdAt   DateTime  @default(now())
  
  @@index([userId])
  @@index([token])
}

// Settings
model Setting {
  id          String    @id @default(cuid())
  
  key         String    @unique
  value       String    @db.Text
  
  updatedAt   DateTime  @updatedAt
}
